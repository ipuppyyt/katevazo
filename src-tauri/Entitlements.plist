<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The bundled yt-dlp is a PyInstaller program that unpacks its own Python at run time.
       With the hardened runtime on, macOS would refuse that Python because its signer
       differs from ours, so library validation is switched off for the sidecars. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- Python and Deno both generate code at run time. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
