{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Katevazo",
  "version": "0.4.0",
  "identifier": "com.artishorizon.katevazo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Katevazo",
        "width": 980,
        "height": 660,
        "minWidth": 720,
        "minHeight": 480,
        "decorations": false,
        "dragDropEnabled": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["katevazo"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/yt-dlp",
      "binaries/ffmpeg",
      "binaries/ffprobe",
      "binaries/deno"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Katevazo contributors",
    "copyright": "Copyright © 2026 Katevazo contributors",
    "category": "Utility",
    "shortDescription": "Fast, simple video downloader",
    "longDescription": "Katevazo is a clean desktop video downloader built on yt-dlp and ffmpeg. Preview a link, pick a quality, and pause, resume or cancel any download.",
    "homepage": "https://github.com/ipuppyyt/katevazo",
    "license": "MIT",
    "licenseFile": "installer/license.rtf",
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "nsis": {
        "template": "installer/installer.nsi",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/nsis-header.bmp",
        "sidebarImage": "installer/nsis-sidebar.bmp",
        "installMode": "both",
        "displayLanguageSelector": false,
        "languages": [
          "English"
        ],
        "startMenuFolder": "Katevazo",
        "compression": "lzma"
      },
      "wix": {
        "language": "en-US",
        "bannerPath": "installer/wix-banner.bmp",
        "dialogImagePath": "installer/wix-dialog.bmp"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "dmg": {
        "background": "installer/dmg-background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 215
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 215
        }
      }
    },
    "linux": {
      "deb": {
        "section": "utils"
      },
      "rpm": {
        "release": "1"
      }
    }
  }
}
