{
  "name": "Katevazo",
  "short_name": "Katevazo",
  "description": "A free, open-source video downloader for Windows, macOS and Linux.",
  "start_url": "./",
  "scope": "./",
  "display": "browser",
  "background_color": "#ffffff",
  "theme_color": "#007aff",
  "icons": [
