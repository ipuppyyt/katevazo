{
  "manifest_version": 3,
  "name": "Send to Katevazo",
  "version": "1.1.0",
  "description": "Send the page you are on, or a link, to the Katevazo app.",
  "permissions": [
    "activeTab",
    "contextMenus"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "youtube.js"
      ],
      "css": [
        "youtube.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Send this page to Katevazo"
  },
  "icons": {
    "128": "icon.png"
  }
}
