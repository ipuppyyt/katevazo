{
  "manifest_version": 3,
  "name": "Send to Katevazo",
  "version": "1.3.0",
  "description": "Send the page you are on, or a link, to the Katevazo app.",
  "permissions": [
    "activeTab",
    "contextMenus",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "hint.js",
        "youtube.js"
      ],
      "css": [
        "youtube.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "hint.js",
        "instagram.js"
      ],
      "css": [
        "instagram.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.vimeo.com/*",
        "https://*.dailymotion.com/*",
        "https://*.x.com/*",
        "https://*.twitter.com/*",
        "https://*.tiktok.com/*",
        "https://*.twitch.tv/*",
        "https://*.facebook.com/*",
        "https://*.reddit.com/*"
      ],
      "js": [
        "hint.js",
        "overlay.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Send this page to Katevazo",
    "default_popup": "popup.html"
  },
  "icons": {
    "128": "icon.png"
  }
}
